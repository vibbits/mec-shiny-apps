col_labeling=col_labeling,
alpha=alpha,
otherfontsize=otherfontsize,
font=font,
legendtitlesize=legendtitlesize,
cohortsize=cohortsize,
include_legend=include_legend,
show_P=show_P)
checkplot
}
iso_charts<-T
if (iso_charts){
