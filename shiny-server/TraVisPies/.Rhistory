)
}
meta_tb<-select(meta_tb,!!sample_symbol,!!!fact_symbols,Normalisation,
!!tracer_symbol,!!sampletype_symbol)
if (norm_column=="None") meta_tb<-select(meta_tb,-Normalisation)
return(meta_tb)
}
