mapcohortsize=mapcohortsize,
width = width, height=height)
datatype_select<-"correctedIsotopologues_C13_C13-5"
compound_select<-"Phosphoenolpyruvic acid"
#plot trends over samples
for (datatype_select in names(table(joined_tb$datatype))) {
for (compound_select in names(table(joined_tb$compound))) {
#get tibble with only desired data, and get a minimal value of 0 or
#whatever lowest value in the tibble below 0, and vice versa for 1 or max
plot_tibble <- joined_tb %>%
filter(compound==compound_select,
datatype==datatype_select)
if(nrow(plot_tibble)==0) next
minval<-min(c(0,plot_tibble$value))
# maxval<-max(c(0.1,plot_tibble$value))
maxval<-NA
plot_tosave<-
ggplot(plot_tibble,
aes(x=cohort, y=value, color=method)) +
geom_point()+
ggtitle(paste0("Compare ",datatype_select,": ",compound_select))+
ylab("value")+
scale_y_continuous(limits = c(minval, maxval),breaks = seq(0,1,0.05))+
geom_hline(yintercept = 0)
#sanitize filenames to avoid /
plotfilename<-paste0(compound_select,".png")%>%
gsub(pattern="/",replacement="-")
ggsave(plotfilename,plot_tosave,device = "png",
path=paste0(outputpath,"/figures/",datatype_select),create.dir = T,
,width = 10, height = 6.5, units = "in")
}
}
