{
if(add_unlab){
mutate(
.,!!label_symbol:=factor(!!label_symbol,
levels=c(label_identities,"Unlabeled"))
)
} else {
mutate(
.,!!label_symbol:=factor(!!label_symbol,
levels=c(label_identities))
)
}
}
return(slice_tb)
}
