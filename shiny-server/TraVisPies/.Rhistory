sampletype_column<-"sample_type"
(factor_levels<-read_excel(inputpath,
which(grepl("meta",tolower(excel_sheets(inputpath)))))%>%
pull(factor_column)%>%
unique())
#set factor levels variables
factor_levels_ordered<-factor_levels[2:4]
#make vector of factors
factor_columns <- c(factor_column,comparative_factor_column)
print(paste0("Selected levels in order as given in factor_levels_ordered: ",paste0(factor_levels_ordered,collapse = ", ")))
checkplot<-plot_fromtibble(tb,charttype="FC",compound_col="compound",
